    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9f6cb5c0-04c5-4c8b-8c82-04a43b84eaf6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
